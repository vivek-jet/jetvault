# Copy to /opt/jetvault/.env and fill in. Never commit the real file.

# Public hostname (no https://). Point a DNS A record at the server's static IP first.
JETVAULT_HOSTNAME=vault.example.com
# Let's Encrypt account email for the HTTPS certificate
ACME_EMAIL=it@example.com

# Admin panel at https://<hostname>/admin. Use an Argon2 PHC hash, not the plain token
# (bootstrap.sh generates one). Single quotes keep the $ signs literal.
ADMIN_TOKEN='$argon2id$...'

# Internal tool: only company addresses may self-register (the whitelist overrides
# SIGNUPS_ALLOWED=false for the listed domains). Anyone else needs an invite from the admin panel.
SIGNUPS_ALLOWED=false
SIGNUPS_DOMAINS_WHITELIST=jetsynthesys.com
# Require new accounts to confirm their email address. Only enforced once SMTP is configured.
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=JetVault
SHOW_PASSWORD_HINT=false

# Email (needed for invites, 2FA by email, new-device alerts). Optional at first.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_FROM=vault@example.com
# SMTP_FROM_NAME=JetVault
# SMTP_SECURITY=starttls
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

LOG_LEVEL=warn
EXTENDED_LOGGING=true
